<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600&display=swap">
  <% var sheets = (typeof stylesheets !== 'undefined' && stylesheets) ? stylesheets : []; %>
  <% sheets.forEach(function (sheet) { %>
  <link rel="stylesheet" href="<%= sheet %>">
  <% }); %>
  <% if (typeof extraStyle !== 'undefined' && extraStyle) { %>
  <style>
    <%- extraStyle %>
  </style>
  <% } %>
</head>
<body>
<%- include('content') %>
